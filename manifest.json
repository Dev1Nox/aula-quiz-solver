{
  "manifest_version": 3,
  "name": "Aula Virtual Quiz Solver",
  "version": "1.1.0",
  "description": "Resuelve cuestionarios de Moodle (aula virtual) usando la API de Groq.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Ajustes del Quiz Solver" },
  "content_scripts": [
    {
      "matches": [
        "*://*/*mod/quiz/attempt.php*",
        "*://*/*mod/quiz/summary.php*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
